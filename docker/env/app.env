APP_NAME="Virtual Company OS"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
FRONTEND_URL=http://localhost:5173

DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=virtual_company
DB_USERNAME=vcos
DB_PASSWORD=vcos

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=hello@virtual-company.test
MAIL_FROM_NAME="Virtual Company OS"

SANCTUM_EXPIRATION=10080
SANCTUM_TOKEN_PREFIX=vcos_

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=vcos
AWS_SECRET_ACCESS_KEY=vcos-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=vcos
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

VCOS_DEFAULT_TIMEZONE=Asia/Tehran
VCOS_DEFAULT_LOCALE=fa
